# 数据库地址
DATABASE_HOST = "127.0.0.1"
# 数据库端口
DATABASE_PORT = 3306
# 数据库用户名
DATABASE_USER = "root"
# 数据库密码
DATABASE_PASSWORD = "Sql87654321."
# 数据库名
DATABASE_NAME = "changhushi"
#数据库编码
DATABASE_CHARSET = "utf8mb4"
# 数据库长连接时间（默认为0，单位秒）即每次请求都重新连接,debug模式下该值应该写为0 ，mysql默认长连接超时时间为8小时
 #推荐120（2分钟），使用 None 则是无限的持久连接（不推荐）。
DATABASE_CONN_MAX_AGE = 0

# ================================================= #
# ************** redis 配置  ************** #
# ================================================= #
REDIS_URL = 'redis://127.0.0.1:6379'

# 未安装/未启动 Redis 时设为 True：Celery 任务在 Django 进程内同步执行（如 SOP 视频分析 .delay）
# 已起 Redis 且单独跑 celery worker 时请改为 False
CELERY_TASK_ALWAYS_EAGER=True

